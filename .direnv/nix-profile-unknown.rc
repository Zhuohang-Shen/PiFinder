shellHook='export LD_LIBRARY_PATH="/nix/store/90yn7340r8yab8kxpb0p7y0c9j3snjam-gcc-13.2.0-lib/lib:/nix/store/6ghariqqf33l5xqn7alx58dys7kz2wm5-zlib-1.3.1/lib:/nix/store/rrw0d53ykhyzwbqayrqzx28hm53krb7i-libjpeg-turbo-3.0.3/lib:/nix/store/xz6qa1y8a7nm544iqkh3nx9pgysnpl0j-libpng-apng-1.6.43/lib:/nix/store/0npkjmcmq2zjmwfr8n9qiphikhi0h27n-freetype-2.13.2/lib:/nix/store/jnskm0dfki060gy78kf0np90lygyyqd4-openblas-0.3.27/lib:/nix/store/28hj0qsngf53sckh5lgzfn2zw66698jv-lapack-3/lib:/nix/store/rbr2xn0qjw8xl7vgmwssy3y2xsn250c9-SDL2-2.30.2/lib:/nix/store/0h4wxy7kgybd4rdwd3mymavc2n43qvlb-SDL2_image-2.8.2/lib:/nix/store/z23rff0vlw55gnjdz1pjapwcr40yy3y2-SDL2_mixer-2.8.0/lib:/nix/store/ina5d70abrs1whlrknvbs7abinsanxin-SDL2_ttf-2.22.0/lib:/nix/store/aqc10czb2whr64agvcpihg96im5i7mi6-wayland-1.22.0/lib:/nix/store/m4r9jmsvgv8k0vsb72vkq91667yjdf9h-libxkbcommon-1.7.0/lib:/nix/store/xc9l92rl3ndvhwi8a6yj01icn1d8vfp9-libGL-1.7.0/lib:/nix/store/jxqbfi5lgyjdcn2js5pp8i8vxp48770k-mesa-24.0.7/lib:/nix/store/5z1p38q7crvid944wrhmiiglvvald0j4-libX11-1.8.9/lib:/nix/store/l6cqv0aflnlvlshkxfchik6gnafqm24g-libXcursor-1.2.2/lib:/nix/store/acw4dh5a3dwbm5w8fdgiq9hxd7sd6a0v-libXrandr-1.5.4/lib:/nix/store/r5j717nmw6yg894a885r3a9wb2kj8sk2-libXi-1.8.1/lib:$LD_LIBRARY_PATH"
